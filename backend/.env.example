# Foster Ulcer AI — backend environment template
#
# Copy this file to backend/.env and fill in real values for local development.
# Never commit backend/.env. .gitignore already excludes it.
#
# In Cloud Run / production, configure these via Secret Manager and the
# service's runtime env vars instead of an .env file.

# ---------------------------------------------------------------------------
# Firebase Admin credentials
# ---------------------------------------------------------------------------
# Path to the service-account JSON. Used for local development only.
# In Cloud Run the K_SERVICE env var is detected automatically and the
# runtime's default application credentials are used; leave this unset there.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account.json

# Optional: override the Firebase Storage bucket. Defaults to the production
# bucket if omitted. Set to a dev bucket when testing locally.
# FIREBASE_STORAGE_BUCKET=foster-ulcer-ai-dev.firebasestorage.app

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser clients. Native mobile
# clients do not need this. Leave empty to disable CORS entirely.
# Example for the future doctor portal:
# CORS_ALLOWED_ORIGINS=https://doctor.foster-ulcer-ai.example,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Standard Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Debug-only flag to log request body metadata (size + content type, never
# the body itself). Do NOT enable this in any environment that handles real
# patient data.
LOG_BODIES=false
